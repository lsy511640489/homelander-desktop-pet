{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐾 Debug: Homelander Pet (默认)",
            "type": "debugpy",
            "request": "launch",
            "module": "homelander_pet.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--profile", "config/pet-profile.example.json"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "🐾 Debug: Homelander Pet (Headless 模式)",
            "type": "debugpy",
            "request": "launch",
            "module": "homelander_pet.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--profile", "config/pet-profile.example.json"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "HOMELANDER_PET_HEADLESS": "1"
            }
        },
        {
            "name": "🐾 Debug: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
